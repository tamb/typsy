{
  "name": "typsy",
  "version": "1.0.0-beta.2",
  "description": "Small, chainable runtime type checks for JavaScript and TypeScript",
  "keywords": [
    "type-check",
    "type-guard",
    "runtime",
    "validation",
    "predicate",
    "chainable",
    "javascript",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamb/typsy.git"
  },
  "homepage": "https://github.com/tamb/typsy#readme",
  "bugs": {
    "url": "https://github.com/tamb/typsy/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "package:check": "npm run build && publint && attw --pack",
    "prepublishOnly": "npm run check && npm run package:check"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "¡Támb!",
  "license": "MIT",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
